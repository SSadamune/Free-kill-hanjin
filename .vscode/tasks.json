{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "平行时空：安装国战依赖",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/scripts/setup_dependencies.py"],
      "problemMatcher": []
    },
    {
      "label": "平行时空：同步扩展",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev.ps1", "-Action", "sync"],
      "problemMatcher": []
    },
    {
      "label": "平行时空：启动开发版",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev.ps1", "-Action", "play"],
      "problemMatcher": []
    },
    {
      "label": "平行时空：构建用户安装包",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/scripts/build_release.py"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "平行时空：检查 Lua 语法",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/scripts/check_lua.py"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "平行时空：运行自动化测试",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/scripts/test.py"],
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    }
  ]
}
