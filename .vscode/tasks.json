{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "紫乔汉晋：同步扩展",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev.ps1", "-Action", "sync"],
      "problemMatcher": []
    },
    {
      "label": "紫乔汉晋：启动开发版",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev.ps1", "-Action", "play"],
      "problemMatcher": []
    },
    {
      "label": "紫乔汉晋：检查 Lua 语法",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/scripts/check_lua.py"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "紫乔汉晋：运行自动化测试",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/scripts/test.py"],
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    }
  ]
}
